# ── Application Configuration ─────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_NAME=nodejs-express-boilerplate
FRONTEND_URL=http://localhost:3000

# ── Database Configuration (Sequelize / PostgreSQL) ───────────────
DB_ADAPTER=postgres
DB_URL=postgres://postgres:postgres@localhost:5432/swp_boilerplate_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swp_boilerplate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ── JWT Authentication ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── Rate Limiting ──────────────────────────────────────────────────
ENABLE_RATE_LIMIT=N
RATE_LIMIT_WINDOWS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_ERROR_MESSAGE="Too many requests, please try again later."

# ── SendGrid Email Service ─────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
MAIL_DEFAULT_FROM=noreply@example.com

# ── Firebase / FCM Push Notifications ──────────────────────────────
# OPTION 1: Path to service account JSON file (e.g., config/firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=

# OPTION 2: Individual credentials (recommended for cloud/container environments)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPTION 3: Entire Service Account JSON stringified in one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── RabbitMQ Configuration ─────────────────────────────────────────
ENABLE_RABBITMQ=N
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
