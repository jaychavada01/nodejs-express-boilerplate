# ── Application Configuration ─────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_NAME=nodejs-express-boilerplate
FRONTEND_URL=http://localhost:3000

# ── Database Configuration (Sequelize / PostgreSQL via DB_URL) ─────
DB_URL=postgres://postgres:postgres@localhost:5432/swp_boilerplate_db
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ── JWT Authentication ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── Rate Limiting ──────────────────────────────────────────────────
ENABLE_RATE_LIMIT=N
RATE_LIMIT_WINDOWS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_ERROR_MESSAGE="Too many requests, please try again later."

# ── SendGrid Email Service ─────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
MAIL_DEFAULT_FROM=noreply@example.com

# ── Firebase / FCM Push Notifications (Individual Credentials) ─────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

# ── RabbitMQ Configuration ─────────────────────────────────────────
ENABLE_RABBITMQ=N
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── Redis Configuration (Caching & Token Blacklist) ────────────────
ENABLE_REDIS=N
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Background Task / Cron Scheduler ───────────────────────────────
ENABLE_CRON=N

# ── Maintenance Mode Gateway ───────────────────────────────────────
MAINTENANCE_MODE=N
MAINTENANCE_BYPASS_SECRET=
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# ── AWS S3 / Cloud Object Storage ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_CUSTOM_DOMAIN=

# ── Cryptography & Encryption ──────────────────────────────────────
ENCRYPTION_KEY=12345678901234567890123456789012

