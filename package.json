{
  "name": "nodejs-express-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready, highly modular Node.js & Express microservice boilerplate with Sequelize, RabbitMQ, SendGrid, and FCM Push Notifications.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "nodejs",
    "express",
    "boilerplate",
    "microservice",
    "sequelize",
    "rabbitmq",
    "fcm",
    "sendgrid",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "amqplib": "^0.10.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.5.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.0"
  }
